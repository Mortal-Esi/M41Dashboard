/**
 * password.local.js.example
 * --------------------------
 * Dashboard logins live in `password.local.js` (same folder). That file is
 * listed in .gitignore and is NEVER committed — it keeps the logins out of
 * the public repo and the public GitHub Pages site.
 *
 * Don't edit it by hand — manage it with make-users.js:
 *
 *   node make-users.js add ali sara     → new users, prints their passwords
 *   node make-users.js reset ali        → new password for ali
 *   node make-users.js remove ali       → ali can no longer log in
 *   node make-users.js list             → usernames only
 *
 * then run refresh-dashboard.bat so the live site uses the new logins.
 *
 * Resulting format (username → password; each person signs in with both):
 *
 *   module.exports = {
 *     ali:  'xxxxxxxxxxxxxxxxxxxx',
 *     sara: 'xxxxxxxxxxxxxxxxxxxx',
 *   };
 *
 * The encrypted file is public, so anyone can try passwords against it
 * offline — that's why make-users.js generates 20 random characters.
 */
module.exports = {};
