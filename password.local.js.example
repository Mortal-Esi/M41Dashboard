/**
 * password.local.js.example
 * --------------------------
 * Copy this file to `password.local.js` (same folder) and set the real
 * dashboard password below. `password.local.js` is listed in .gitignore
 * and is NEVER committed — this keeps the access password out of the
 * public repo and the public GitHub Pages site.
 *
 *   cp password.local.js.example password.local.js
 *
 * Then edit password.local.js and replace CHANGE_ME with the real
 * password. encrypt.js (via update_dashboard.js) reads it from there.
 */
module.exports = 'CHANGE_ME';
