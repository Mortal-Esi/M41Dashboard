/**
 * password.local.js.example
 * --------------------------
 * Copy this file to `password.local.js` (same folder) and set the real
 * dashboard password(s) below. `password.local.js` is listed in .gitignore
 * and is NEVER committed — this keeps the access passwords out of the
 * public repo and the public GitHub Pages site.
 *
 *   cp password.local.js.example password.local.js
 *
 * Option A — one shared password for everyone:
 *
 *   module.exports = 'CHANGE_ME';
 *
 * Option B — each person gets their own password (labels are just for you;
 * they're never published). To revoke someone, delete their line and run
 * `node update_dashboard.js` (or `node encrypt.js`) again — nobody else's
 * password changes:
 *
 *   module.exports = {
 *     ali:  'CHANGE_ME',
 *     sara: 'CHANGE_ME',
 *   };
 *
 * The encrypted file is public, so anyone can try passwords against it
 * offline — use at least 12 random characters (encrypt.js warns otherwise).
 */
module.exports = 'CHANGE_ME';
